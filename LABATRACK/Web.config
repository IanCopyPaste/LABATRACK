<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <!-- EMAIL (SMTP): the shop's Gmail address and its app password are secrets, so they are not in
       this file. They go in Secrets.config next to it (listed in .gitignore): open Secrets.config and
       replace the two PUT-YOUR-... placeholders. README.md shows the file in full.
       If Secrets.config is missing or still has the placeholders, the site still runs; emails are
       logged as Failed until it is filled in. -->
  <appSettings file="Secrets.config" />
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <pages>
      <namespaces>
        <!-- lets every .aspx call Icons.Get(...) without an Import directive -->
        <add namespace="LABATRACK.Helpers" />
      </namespaces>
    </pages>
    <!-- Sign-in: Forms authentication with a cookie that holds only the username. Forms authentication
         knows one login page, the staff one; Login.aspx forwards anyone headed for Admin/ to the owner's. -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" name=".LABATRACK" timeout="600" slidingExpiration="true" cookieless="UseCookies" />
    </authentication>
    <!-- Nobody who is not signed in may open any page, except the ones allowed below. -->
    <authorization>
      <deny users="?" />
    </authorization>
    <!-- Roles (Owner, Staff) come from the Users table on every request, through Security/LabaTrackRoleProvider.cs.
         This is what lets the Admin folder below be closed to the Staff role. -->
    <roleManager enabled="true" defaultProvider="LabaTrackRoles" cacheRolesInCookie="false">
      <providers>
        <clear />
        <add name="LabaTrackRoles" type="LABATRACK.Security.LabaTrackRoleProvider" />
      </providers>
    </roleManager>
  </system.web>

  <!-- Pages anyone may open: the two login pages, the front door, and signing out. -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Default.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Logout.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- Stylesheets, scripts, the font and the icons, which the login pages need too. -->
  <location path="Assets">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <!-- The owner's folder: only the Owner role. A staff account that types an Admin address is refused
       here, before the page runs; AdminBasePage checks again. -->
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Owner" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- ...except the owner's login page itself, or it would lock itself out. -->
  <location path="Admin/Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <!-- START PAGE: the page that loads first when the site's address is opened on its own
         (for example https://localhost:44327/). Login.aspx is the staff sign-in, which links to the
         owner's (Admin/Login.aspx); someone already signed in is sent straight on to their dashboard.
         Visual Studio's F5 opens the same page (Start Page = Login.aspx in the project properties). -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Login.aspx" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- serve the local font in ~/Assets/fonts -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
	<connectionStrings>
		<add name="LABATRACK_conn" 
			 connectionString="Server=(localdb)\IPTconnection;Database=labatrack;Trusted_Connection=True;" 
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>